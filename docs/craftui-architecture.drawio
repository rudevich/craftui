<mxCell id="e10" value="Bash ⇄ карточка" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="пишет" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l4" value="1) запускает receiver в фоне&lt;br&gt;2) выполняет напечатанный сниппет во вкладке Figma&lt;br&gt;3) получает только сводку: число узлов, фреймы, компоненты" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="570" width="280" height="170" as="geometry"/></mxCell>
<mxCell id="c4a" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;extract {&quot;action&quot;:&quot;receiver&quot;}&lt;/font&gt;&lt;/b&gt; (фон, 127.0.0.1:4601) — receiver.ts&lt;br&gt;только *.figma.com, 30 мин простоя; последняя выгрузка сниппета несёт &lt;font face=&quot;Menlo&quot;&gt;done=&amp;lt;шаг&amp;gt;&lt;/font&gt; — receiver закрывает extract/screenshots сам" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="570" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="c4b" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;extract {&quot;action&quot;:&quot;snippet&quot;,&quot;entity&quot;:…,&quot;step&quot;:&quot;probe-extract&quot;}&lt;/font&gt;&lt;/b&gt; — один прогон: разведка + выгрузка&lt;br&gt;snippets.ts печатает готовый JS (renderSnippet)&lt;br&gt;результат дублируется в &lt;font face=&quot;Menlo&quot;&gt;window.__craftui&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="f4" value="Вкладка Figma выполняет сниппет:&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;extract.ts&lt;/font&gt; | &lt;font face=&quot;Menlo&quot;&gt;extract-page.ts&lt;/font&gt;&lt;br&gt;+ &lt;font face=&quot;Menlo&quot;&gt;lib/core.ts&lt;/font&gt; (сериализатор слоёв: css, переменные, стили, экземпляры, режимы;&lt;br&gt;варианты — пулом, усечение фиксировано заранее)&lt;br&gt;+ &lt;font face=&quot;Menlo&quot;&gt;lib/plugin.ts&lt;/font&gt; (saver → POST в receiver, pool)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1110" y="570" width="310" height="170" as="geometry"/></mxCell>
<mxCell id="d4" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;craftlog/figma/raw/plugin.json&lt;/font&gt;&lt;/b&gt;&lt;br&gt;сотни КБ, LLM не открывает" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1450" y="570" width="320" height="170" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="Bash, в фоне" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="c4a"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="сниппет (probe-extract)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="c4b"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" value="evaluate_script ⇄ сводка" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" value="POST raw/PNG (done=&amp;lt;шаг&amp;gt;) закрывает шаг" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;exitX=0;exitY=0.25;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f4" target="c4a"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e17" value="пишет на диск" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4a" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l4m" value="Вызывает инструменты Figma MCP по одному и сохраняет ответы в файлы, не перечитывая" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="390" y="760" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="f4m" value="&lt;b&gt;Figma MCP&lt;/b&gt;: &lt;font face=&quot;Menlo&quot;&gt;get_metadata&lt;/font&gt;, &lt;font face=&quot;Menlo&quot;&gt;get_variable_defs&lt;/font&gt;, &lt;font face=&quot;Menlo&quot;&gt;get_design_context&lt;/font&gt; (по вариантам)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="760" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="d4m" value="&lt;font face=&quot;Menlo&quot;&gt;raw/metadata.xml&lt;/font&gt;, &lt;font face=&quot;Menlo&quot;&gt;raw/variables.json&lt;/font&gt;, &lt;font face=&quot;Menlo&quot;&gt;raw/design-context/*.tsx&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1450" y="760" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="e18" value="или" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;dashed=1;curved=1;fontSize=10;curved=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="l4m"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e19" value="MCP-вызов ⇄ ответ" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4m" target="f4m"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e20" value="Write" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4m" target="d4m"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l5" value="Читает сводку normalize: targets, свойства, токены, предупреждения — шаг закрывается сам" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="870" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;spec {&quot;action&quot;:&quot;normalize&quot;}&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;normalize.ts&lt;/font&gt; (raw Plugin API) | &lt;font face=&quot;Menlo&quot;&gt;normalize-mcp.ts&lt;/font&gt; (MCP)&lt;br&gt;| &lt;font face=&quot;Menlo&quot;&gt;normalize-page.ts&lt;/font&gt; (брейкпоинты, flow-раскладка, части)&lt;br&gt;+ &lt;font face=&quot;Menlo&quot;&gt;slots.ts&lt;/font&gt;, &lt;font face=&quot;Menlo&quot;&gt;units.ts&lt;/font&gt;; схема — &lt;font face=&quot;Menlo&quot;&gt;types.ts&lt;/font&gt; Spec" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="870" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="d5" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;craftlog/figma/spec.json&lt;/font&gt;&lt;/b&gt;&lt;br&gt;узлы, css, targets, свойства, токены, экземпляры, ассеты" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1450" y="870" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="e21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=3;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4m" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=0.1;exitY=1;entryX=0.1;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="Bash ⇄ сводка" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l5" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="читает raw" style="endArrow=open;html=1;strokeColor=#999999;dashed=1;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
