<mxCell id="l9" value="Запускает; шаг закрывается сам, конфликты значений решает с пользователем (tokens.md)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="1340" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;build {&quot;action&quot;:&quot;tokens&quot;}&lt;/font&gt;&lt;/b&gt; — &lt;font face=&quot;Menlo&quot;&gt;tokens.ts&lt;/font&gt;: переменные и стили → CSS-переменные, режимы (data-theme, data-typography)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1340" width="380" height="70" as="geometry"/></mxCell>
