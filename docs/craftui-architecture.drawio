<mxCell id="e36" value="читает / пишет" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell>
