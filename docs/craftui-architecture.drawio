<mxCell id="l0" value="Разбирает аргументы по &lt;b&gt;SKILL.md&lt;/b&gt;&lt;br&gt;(скилл: ~/.claude/skills/craftui, в проекте — копия .craftui/skill/)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="280" height="90" as="geometry"/></mxCell>
