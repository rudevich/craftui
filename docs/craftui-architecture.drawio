<mxCell id="l6" value="Показывает &lt;font face=&quot;Menlo&quot;&gt;normalize --summary&lt;/font&gt;, задаёт вопросы" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="1000" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="u6" value="Подтверждает свойства, targets, слоты; у страницы — части и макеты устройств" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="1000" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;spec {&quot;action&quot;:&quot;prop&quot;/&quot;slot&quot;/&quot;part&quot;/&quot;mockup&quot;}&lt;/font&gt;&lt;/b&gt;&lt;br&gt;slots.ts, normalize-page.ts&lt;br&gt;→ &lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;normalize {&quot;keep&quot;:true}&lt;/font&gt;&lt;/b&gt; (ручные правки сохраняются)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1000" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="e26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e27" value="вопрос ⇄ ответ" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#d6b656;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l6" target="u6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e28" value="правки" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l6" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e29" value="обновляет spec.json" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;exitX=1;exitY=0.5;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l7" value="Выполняет сниппет export во вкладке Figma (receiver работает); все targets без ошибок — шаг закрывается сам" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="1110" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;extract {&quot;action&quot;:&quot;snippet&quot;,&quot;step&quot;:&quot;export&quot;}&lt;/font&gt;&lt;/b&gt; → &lt;font face=&quot;Menlo&quot;&gt;export.ts&lt;/font&gt; | &lt;font face=&quot;Menlo&quot;&gt;export-page.ts&lt;/font&gt;&lt;br&gt;по токену: &lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;extract {&quot;action&quot;:&quot;rest-images&quot;}&lt;/font&gt;&lt;/b&gt; → &lt;font face=&quot;Menlo&quot;&gt;rest.ts&lt;/font&gt; (кэш эталонов, PNG параллельно)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1110" width="380" height="100" as="geometry"/></mxCell>
<mxCell id="f7" value="&lt;font face=&quot;Menlo&quot;&gt;exportAsync&lt;/font&gt;: PNG каждого target / брейкпоинта (scale из конфига), SVG и PNG ассетов — пулом&lt;br&gt;&lt;i&gt;MCP: api.figma.com/v1/images&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1110" y="1110" width="310" height="100" as="geometry"/></mxCell>
<mxCell id="d7" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;craftlog/figma/screenshots/*.png&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;bounds.json&lt;/font&gt;, ассеты (svg, png)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1450" y="1110" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="e30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e31" value="сниппет export" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l7" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e32" value="evaluate_script" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l7" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e33" value="POST в receiver → диск" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f7" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l8" value="Неимпортированный вложенный компонент → сначала &lt;font face=&quot;Menlo&quot;&gt;new component &amp;lt;Dep&amp;gt; --parent &amp;lt;Name&amp;gt;&lt;/font&gt; (тот же цикл), или &lt;font face=&quot;Menlo&quot;&gt;--inline&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="390" y="1230" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;&lt;font face=&quot;Menlo&quot;&gt;spec {&quot;action&quot;:&quot;deps&quot;}&lt;/font&gt;&lt;/b&gt; — &lt;font face=&quot;Menlo&quot;&gt;deps.ts&lt;/font&gt;&lt;br&gt;экземпляры ↔ уже импортированные сущности (ключ, nodeId, &lt;font face=&quot;Menlo&quot;&gt;same&lt;/font&gt;)&lt;br&gt;все разрешены — шаг закрывается сам" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1230" width="380" height="90" as="geometry"/></mxCell>
